# Copy to .env and fill in what you use. Never commit .env.
# Everything is optional except the dashboard settings; missing credentials
# simply switch that source or platform off, with a note on the dashboard.

# --- Claude (research, writing, review) ---------------------------------------
ANTHROPIC_API_KEY=

# --- Dashboard ----------------------------------------------------------------
DASHBOARD_USERNAME=admin
# Preferred: a hash from `python -m app hash-password`
DASHBOARD_PASSWORD_HASH=
# Or a plain password (only if you cannot use the hash)
DASHBOARD_PASSWORD=
# Random, 32+ characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# true when the dashboard is served over HTTPS (it should be, anywhere but localhost)
COOKIE_SECURE=false
# Bearer token for POST /api/trigger (used by the GitHub Actions workflow), 24+ characters
TRIGGER_TOKEN=

# --- Storage ------------------------------------------------------------------
# DATABASE_PATH=./data/trendscout.db
# TRENDSCOUT_CONFIG=./config/trendscout.toml

# --- Trend sources ------------------------------------------------------------
# Reddit app (https://www.reddit.com/prefs/apps), "script" type is fine
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=script:trendscout:1.0 (by /u/your_reddit_username)
# YouTube Data API v3 key (Google Cloud console)
YOUTUBE_API_KEY=
# X API bearer token, only on a tier that includes trends
X_BEARER_TOKEN=

# --- Bluesky (first platform) ------------------------------------------------
BLUESKY_HANDLE=yourname.bsky.social
# App password from Settings -> Privacy and security -> App passwords. NOT your main password.
BLUESKY_APP_PASSWORD=
# BLUESKY_PDS=https://bsky.social
# BLUESKY_LANG=en

# --- X (posting) --------------------------------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Threads ------------------------------------------------------------------
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Instagram (professional account) -------------------------------------------
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_GRAPH_VERSION=v23.0

# --- LinkedIn -----------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:XXXXXXXX
# LINKEDIN_VERSION=202609

# --- TikTok -------------------------------------------------------------------
TIKTOK_ACCESS_TOKEN=
# SELF_ONLY until your app passes TikTok's audit
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY
