 "lines": [
  {
   "scene": null,
   "text": "You were taught Rome fell in 476.",
   "start": 0.12,
   "end": 2.467
  },
  {
   "scene": null,
   "text": "That's wrong.",
   "start": 2.647,
   "end": 3.463
  },
  {
   "scene": null,
   "text": "At its peak, Rome ruled from Britain to Egypt:",
   "start": 3.963,
   "end": 6.507
  },
  {
   "scene": null,
   "text": "three continents, and maybe one in four people on Earth.",
   "start": 6.667,
   "end": 9.663
  },
  {
   "scene": null,
   "text": "In 117 AD, under Emperor Trajan, it hit its biggest size ever.",
   "start": 10.003,
   "end": 14.29
  },
  {
   "scene": null,
   "text": "Then it cracked.",
   "start": 14.63,
   "end": 15.534
  },
  {
   "scene": null,
   "text": "Civil wars.",
   "start": 15.994,
   "end": 17.0
  },
  {
   "scene": null,
   "text": "Plague.",
   "start": 17.14,
   "end": 17.773
  },
  {
   "scene": null,
   "text": "Invaders on every border.",
   "start": 17.913,
   "end": 19.577
  },
  {
   "scene": null,
   "text": "So Rome split in two.",
   "start": 19.797,
   "end": 21.083
  },
  {
   "scene": null,
   "text": "In 476, the West collapsed.",
   "start": 21.483,
   "end": 23.639
  },
  {
   "scene": null,
   "text": "But the East kept going.",
   "start": 23.799,
   "end": 25.159
  },
  {
   "scene": null,
   "text": "For almost a thousand more years, until 1453.",
   "start": 25.519,
   "end": 28.828
  },
  {
   "scene": null,
   "text": "So when did Rome really fall?",
   "start": 29.168,
   "end": 30.768
  }
 ]
}