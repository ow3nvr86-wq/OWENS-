{
 "duration": 42.919,
 "frames": 1288,
 "phrases": [
  {
   "text": "He beat a Cyclops,",
   "start": 0.0,
   "end": 1.268,
   "line": 0
  },
  {
   "text": "a witch and the land of the dead.",
   "start": 1.423,
   "end": 3.347,
   "line": 0
  },
  {
   "text": "But the real monster...",
   "start": 3.951,
   "end": 5.101,
   "line": 0
  },
  {
   "text": "was him.",
   "start": 5.608,
   "end": 6.199,
   "line": 0
  },
  {
   "text": "Troy has fallen.",
   "start": 6.722,
   "end": 7.902,
   "line": 1
  },
  {
   "text": "Odysseus just wants to go home.",
   "start": 8.457,
   "end": 10.454,
   "line": 1
  },
  {
   "text": "A Cyclops eats his men.",
   "start": 10.951,
   "end": 12.528,
   "line": 2
  },
  {
   "text": "Giants sink his ships.",
   "start": 13.4,
   "end": 14.527,
   "line": 2
  },
  {
   "text": "A witch turns his crew into pigs.",
   "start": 14.931,
   "end": 17.167,
   "line": 2
  },
  {
   "text": "He visits the dead,",
   "start": 17.596,
   "end": 18.59,
   "line": 2
  },
  {
   "text": "slips past the Sirens,",
   "start": 18.834,
   "end": 20.295,
   "line": 2
  },
  {
   "text": "and his starving men eat a god's cattle.",
   "start": 20.464,
   "end": 22.729,
   "line": 2
  },
  {
   "text": "A storm kills them all.",
   "start": 23.178,
   "end": 24.654,
   "line": 2
  },
  {
   "text": "A nymph feeds him lotus.",
   "start": 25.102,
   "end": 26.67,
   "line": 3
  },
  {
   "text": "He forgets home for seven years.",
   "start": 27.043,
   "end": 29.195,
   "line": 3
  },
  {
   "text": "Back home,",
   "start": 29.566,
   "end": 30.158,
   "line": 4
  },
  {
   "text": "suitors want his throne.",
   "start": 30.356,
   "end": 31.684,
   "line": 4
  },
  {
   "text": "He returns in disguise,",
   "start": 32.103,
   "end": 33.487,
   "line": 4
  },
  {
   "text": "strings the bow no one else can...",
   "start": 33.706,
   "end": 35.709,
   "line": 4
  },
  {
   "text": "and the suitors pay.",
   "start": 36.048,
   "end": 37.112,
   "line": 4
  },
  {
   "text": "The twist?",
   "start": 37.568,
   "end": 38.122,
   "line": 5
  },
  {
   "text": "The raiders from the sea everyone feared were the Greeks.",
   "start": 38.528,
   "end": 41.601,
   "line": 5
  },
  {
   "text": "They were him.",
   "start": 42.053,
   "end": 42.679,
   "line": 5
  }
 ]
}