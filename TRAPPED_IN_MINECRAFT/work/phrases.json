 "phrases": [
  {
   "text": "You wake up trapped in Minecraft.",
   "start": 0.0,
   "end": 1.963,
   "line": 0
  },
  {
   "text": "No tools,",
   "start": 2.541,
   "end": 3.264,
   "line": 0
  },
  {
   "text": "no food,",
   "start": 3.451,
   "end": 4.189,
   "line": 0
  },
  {
   "text": "and about ten minutes until dark.",
   "start": 4.404,
   "end": 5.98,
   "line": 0
  },
  {
   "text": "So you punch a tree.",
   "start": 6.627,
   "end": 7.779,
   "line": 1
  },
  {
   "text": "Bare-handed.",
   "start": 8.272,
   "end": 9.076,
   "line": 1
  },
  {
   "text": "It works...",
   "start": 9.655,
   "end": 10.28,
   "line": 1
  },
  {
   "text": "and the top of the tree just floats there.",
   "start": 10.8,
   "end": 12.859,
   "line": 1
  },
  {
   "text": "You make a pickaxe and mine a mountain.",
   "start": 13.551,
   "end": 15.371,
   "line": 2
  },
  {
   "text": "Sixty-four blocks of stone go in your pocket.",
   "start": 15.805,
   "end": 18.197,
   "line": 2
  },
  {
   "text": "Over a hundred and fifty tonnes.",
   "start": 18.589,
   "end": 20.643,
   "line": 2
  },
  {
   "text": "You don't even notice.",
   "start": 21.138,
   "end": 22.071,
   "line": 2
  },
  {
   "text": "The sun's going down.",
   "start": 22.674,
   "end": 23.575,
   "line": 3
  },
  {
   "text": "You slap together a house.",
   "start": 24.076,
   "end": 25.231,
   "line": 3
  },
  {
   "text": "Four walls,",
   "start": 25.611,
   "end": 26.32,
   "line": 3
  },
  {
   "text": "a door,",
   "start": 26.444,
   "end": 26.967,
   "line": 3
  },
  {
   "text": "no windows.",
   "start": 27.176,
   "end": 27.875,
   "line": 3
  },
  {
   "text": "Windows are for people who aren't scared.",
   "start": 28.258,
   "end": 29.961,
   "line": 3
  },
  {
   "text": "You made it.",
   "start": 30.503,
   "end": 31.075,
   "line": 4
  },
  {
   "text": "You climb into bed...",
   "start": 31.549,
   "end": 32.465,
   "line": 4
  },
  {
   "text": "...and through the one gap you forgot to fill,",
   "start": 32.932,
   "end": 35.035,
   "line": 5
  },
  {
   "text": "two glowing white eyes are watching you.",
   "start": 35.392,
   "end": 37.668,
   "line": 5
  },
  {
   "text": "Herobrine.",
   "start": 38.434,
   "end": 39.116,
   "line": 6
  },
  {
   "text": "The guy the game swears it removed.",
   "start": 39.709,
   "end": 41.855,
   "line": 6
  }
 ]
}